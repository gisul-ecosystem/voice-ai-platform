MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=voiceai_pilot

# LiveKit — used when minting room tokens for live proctoring
LIVEKIT_URL=wss://your-livekit-instance
LIVEKIT_WS_URL=wss://your-livekit-instance
LIVEKIT_SERVER_URL=wss://your-livekit-instance
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=45
LIVEKIT_ROOM_CAPACITY=2
# Keep rooms alive for the interview window. LiveKit default empty_timeout is
# 300s and will RoomDelete mid-interview if occupancy looks empty.
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=3600
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SECONDS=120
# Local default. Staging Compose overrides to aaptor-staging.
LIVEKIT_AGENT_NAME=aaptor
APP_ENV=development
BACKEND_SERVICE_TOKEN=
VOICE_AGENT_SERVICE_TOKEN=
INTERVIEW_INVITATION_SECRET=
INTERVIEW_CONTEXT_TTL_HOURS=24
INTERVIEW_CONTEXT_RETENTION_DAYS=30
INTERVIEW_RETENTION_DAYS=365
API_RATE_LIMIT_PER_MINUTE=120
# Optional origins for direct API development. The maintained frontend uses a
# same-origin server proxy and does not require browser access to this service.
TEST_FRONTEND_ORIGINS=http://localhost:3000

# Point these at Laptop 1/2/3 LAN IPs, or a hosted OpenAI-compatible /v1 URL
LLM_SERVICE_URL=http://192.168.1.11:11434/v1
STT_SERVICE_URL=http://192.168.1.12:5552
TTS_SERVICE_URL=http://192.168.1.13:5553
CONTEXT_ENGINE_URL=http://localhost:5555
CONTEXT_ENGINE_TIMEOUT_SECONDS=10
# Hot interview-brain snapshots (layer 2). Optional in local/dev; required for
# multi-worker production recovery. Falls back to process memory if unset.
REDIS_URL=redis://192.168.1.13:6379/0
INTERVIEW_BRAIN_REDIS_TTL_SECONDS=21600

LLM_MODEL_NAME=qwen3:4b-instruct-2507-q8_0
LLM_TIMEOUT_SECONDS=60
HTTP_CONNECT_TIMEOUT_SECONDS=5
HEALTH_TIMEOUT_SECONDS=3
LLM_HEALTH_URL=
LOG_LEVEL=INFO

# Product policy is resolved by backend-api and sent to the private worker as
# room metadata. Empty provider values let each worker use its own .env default.
INTERVIEWER_PROVIDER_POLICY=interviewer-default
INTERVIEWER_LLM_PROVIDER=
INTERVIEWER_STT_PROVIDER=
INTERVIEWER_TTS_PROVIDER=
CUSTOMER_SUPPORT_PROVIDER_POLICY=customer-support-default
CUSTOMER_SUPPORT_LLM_PROVIDER=
CUSTOMER_SUPPORT_STT_PROVIDER=
CUSTOMER_SUPPORT_TTS_PROVIDER=
