# LiveKit (livekit-agents CLI reads LIVEKIT_URL). Aliases are accepted too.
LIVEKIT_URL=wss://your-livekit-instance
LIVEKIT_WS_URL=wss://your-livekit-instance
LIVEKIT_SERVER_URL=wss://your-livekit-instance
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=2
LIVEKIT_ROOM_CAPACITY=5
LIVEKIT_AGENT_NAME=aaptor
RACKO_AGENT_NAME=racko
APP_ENV=development
VOICE_AGENT_SERVICE_TOKEN=
# Distinct health ports allow both production-mode workers to run together.
AAPTOR_WORKER_PORT=8081
RACKO_WORKER_PORT=8082

# OpenAI-compatible base URL (Ollama LAN or hosted, e.g. https://host/v1)
LLM_SERVICE_URL=http://192.168.1.11:11434/v1
STT_SERVICE_URL=http://192.168.1.12:5552
TTS_SERVICE_URL=http://192.168.1.13:5553
BACKEND_API_URL=http://localhost:5554
CONTEXT_ENGINE_URL=http://localhost:5555

# Per-service HTTP timeouts (seconds). Connect timeout is shared.
LLM_TIMEOUT_SECONDS=30
STT_TIMEOUT_SECONDS=30
TTS_TIMEOUT_SECONDS=30
BACKEND_TIMEOUT_SECONDS=60
CONTEXT_ENGINE_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
# Total attempts including the first try (2-3 recommended)
HTTP_RETRY_ATTEMPTS=3

LLM_MODEL_NAME=qwen3:4b-instruct-2507-q8_0
TTS_VOICE=af_heart
LOG_LEVEL=INFO

# LLM: self_hosted or openai
LLM_PROVIDER=self_hosted
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# STT: self_hosted (Nemotron URL), openai, or sarvam (Saaras v3)
STT_PROVIDER=self_hosted
STT_API_KEY=
SARVAM_API_KEY=
SARVAM_STT_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE=unknown
# Realtime WS: fast | balanced | simulated. REST still uses SARVAM_STT_MODEL.
SARVAM_STT_STREAM_TYPE=fast

# TTS: self_hosted (Kokoro URL), openai, or elevenlabs
TTS_PROVIDER=self_hosted
TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Stage 1 inputs if the LiveKit room has no metadata JSON
JOB_DESCRIPTION=
RESUME_TEXT=
MAX_PROBES_PER_PHASE=2
